From c53f85342bac5e26fa457284d8ec9c6ad28f98e3 Mon Sep 17 00:00:00 2001
From: diamondStar35 <ramymaherali55@gmail.com>
Date: Tue, 27 Oct 2026 13:25:06 +0300
Subject: [PATCH] packages: specialize the common library profile for LGPL

---
 packages/ffmpeg.cmake     | 25 ++++++++-----------------
 packages/libarchive.cmake |  3 +--
 packages/mpv.cmake        |  8 +++-----
 3 files changed, 12 insertions(+), 24 deletions(-)

diff --git a/packages/ffmpeg.cmake b/packages/ffmpeg.cmake
index ec2d5a4..9d12948 100644
--- a/packages/ffmpeg.cmake
+++ b/packages/ffmpeg.cmake
@@ -6,12 +6,8 @@ ExternalProject_Add(ffmpeg
         lame
         lcms2
         openssl
-        libssh
-        libsrt
         libass
         libbluray
-        libdvdnav
-        libdvdread
         libmodplug
         libpng
         libsoxr
@@ -25,19 +21,15 @@ ExternalProject_Add(ffmpeg
         opus
         speex
         vorbis
-        x264
-        ${ffmpeg_x265}
         libxml2
         libvpl
         libopenmpt
         libjxl
         libplacebo
-        libzvbi
         libaribcaption
         svtav1
         dav1d
         ${ffmpeg_uavs3d}
-        ${ffmpeg_davs2}
         libva
     GIT_REPOSITORY https://github.com/FFmpeg/FFmpeg.git
     SOURCE_DIR ${SOURCE_LOCATION}
@@ -52,14 +44,14 @@ ExternalProject_Add(ffmpeg
         --pkg-config-flags=--static
         --enable-cross-compile
         --enable-runtime-cpudetect
-        --enable-gpl
+        --disable-gpl
         --enable-version3
         --disable-avisynth
         --disable-vapoursynth
         --enable-libass
         --enable-libbluray
-        --enable-libdvdnav
-        --enable-libdvdread
+        --disable-libdvdnav
+        --disable-libdvdread
         --enable-libfreetype
         --enable-libfribidi
         --enable-libfontconfig
@@ -76,23 +68,22 @@ ExternalProject_Add(ffmpeg
         --disable-librubberband
         --enable-libvpx
         --enable-libwebp
-        --enable-libx264
-        --enable-libx265
+        --disable-libx264
+        --disable-libx265
         --disable-libaom
         --enable-libsvtav1
         --enable-libdav1d
-        ${ffmpeg_davs2_cmd}
         ${ffmpeg_uavs3d_cmd}
         --enable-libzimg
         --enable-openssl
         --enable-libxml2
         --enable-libmysofa
-        --enable-libssh
-        --enable-libsrt
+        --disable-libssh
+        --disable-libsrt
         --enable-libvpl
         --enable-libjxl
         --enable-libplacebo
-        --enable-libzvbi
+        --disable-libzvbi
         --enable-libaribcaption
         --enable-cuda-llvm
         --enable-cuvid
diff --git a/packages/libarchive.cmake b/packages/libarchive.cmake
index 39f0396..7902fab 100644
--- a/packages/libarchive.cmake
+++ b/packages/libarchive.cmake
@@ -1,7 +1,6 @@
 ExternalProject_Add(libarchive
     DEPENDS
         bzip2
-        lzo
         xz
         zlib
         zstd
@@ -26,7 +25,7 @@ ExternalProject_Add(libarchive
         -DENABLE_ICONV=ON
         -DENABLE_LIBXML2=ON
         -DENABLE_EXPAT=OFF
-        -DENABLE_LZO=ON
+        -DENABLE_LZO=OFF
         -DENABLE_LZMA=ON
         -DENABLE_CPIO=OFF
         -DENABLE_CAT=OFF
diff --git a/packages/mpv.cmake b/packages/mpv.cmake
index eb9ae4b..d44612a 100644
--- a/packages/mpv.cmake
+++ b/packages/mpv.cmake
@@ -7,8 +7,6 @@ ExternalProject_Add(mpv
         lcms2
         libarchive
         libass
-        libdvdnav
-        libdvdread
         libiconv
         libjpeg
         libpng
@@ -35,7 +33,7 @@ ExternalProject_Add(mpv
         -Db_lto=true
         ${mpv_lto_mode}
         -Dcplayer=false
-        -Dgpl=true
+        -Dgpl=false
         -Ddirect3d=disabled
         -Dlibmpv=true
         -Dpdf-build=disabled
@@ -46,8 +44,8 @@ ExternalProject_Add(mpv
         -Dsdl2-video=disabled
         -Dlibarchive=enabled
         -Dlibbluray=enabled
-        -Ddvda=enabled
-        -Ddvdnav=enabled
+        -Ddvda=disabled
+        -Ddvdnav=disabled
         -Duchardet=enabled
         -Drubberband=disabled
         -Dlcms2=enabled
-- 
2.54.0.windows.1

