From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: diamondStar35 <ramymaherali55@gmail.com>
Date: Fri, 30 Oct 2026 22:40:33 +0000
Subject: [PATCH] fontconfig: refresh custom patch for the indexer query path

Fontconfig renamed FcFileScanFontConfig to FcFileScanFontFile and replaced
the query_function dispatch with FcIndexerQueryAll. Refresh the existing
patch against b6cf4b270c42b13347a4012cdceb9bbc3d2e8f32 while preserving
its font scanning output and Windows fallback configuration changes.

The old context failed before Fontconfig configuration and prevented the
FFmpeg build from starting. Keep the patch required for every variant.
---
diff --git a/packages/fontconfig-0001-Custom-changes-for-mpv-builds.patch b/packages/fontconfig-0001-Custom-changes-for-mpv-builds.patch
index 8317ca38891b83fcdae914eb5cd784dfa7d50375..4ae0069ec0d8cb4a467c271a87d607b1a6a4a9b1 100644
--- a/packages/fontconfig-0001-Custom-changes-for-mpv-builds.patch
+++ b/packages/fontconfig-0001-Custom-changes-for-mpv-builds.patch
@@ -10,10 +10,10 @@ Based on original lachs0r's patch for fontconfig
  2 files changed, 59 insertions(+), 9 deletions(-)
 
 diff --git a/src/fcdir.c b/src/fcdir.c
-index c17875f..8348bf5 100644
+index f0bcca5dbfcf969dc1100fc73e78ab7edc44cf8a..12cee3dc981616f1b3607ed6143fe51b204b2278 100644
 --- a/src/fcdir.c
 +++ b/src/fcdir.c
-@@ -80,10 +80,7 @@ FcFileScanFontConfig (FcFontSet     *set,
+@@ -72,17 +72,11 @@ FcFileScanFontFile (FcFontSet     *set,
      int            old_nfont = set->nfont;
      const FcChar8 *sysroot = FcConfigGetSysRoot (config);
  
@@ -23,10 +23,7 @@ index c17875f..8348bf5 100644
 -    }
 +
  
-     unsigned int (*query_function) (const FcChar8 *, unsigned int, FcBlanks *, int *, FcFontSet *) =
- #if ENABLE_FONTATIONS && !defined(ENABLE_FREETYPE)
-@@ -100,9 +97,6 @@ FcFileScanFontConfig (FcFontSet     *set,
-     if (!query_function (file, -1, NULL, NULL, set))
+     if (!FcIndexerQueryAll (file, -1, NULL, set))
  	return FcFalse;
  
 -    if (FcDebug() & FC_DBG_SCAN)
@@ -35,7 +32,7 @@ index c17875f..8348bf5 100644
      for (i = old_nfont; i < set->nfont; i++) {
  	FcPattern *font = set->fonts[i];
  
-@@ -243,7 +237,7 @@ FcDirScanConfig (FcFontSet     *set,
+@@ -227,7 +221,7 @@ FcDirScanConfig (FcFontSet     *set,
      base = file_prefix + strlen ((char *)file_prefix);
  
      if (FcDebug() & FC_DBG_SCAN)
@@ -44,7 +41,7 @@ index c17875f..8348bf5 100644
  
      d = opendir ((char *)s_dir);
      if (!d) {
-@@ -282,8 +276,29 @@ FcDirScanConfig (FcFontSet     *set,
+@@ -266,8 +260,29 @@ FcDirScanConfig (FcFontSet     *set,
      /*
       * Scan file files to build font patterns
       */
@@ -76,7 +73,7 @@ index c17875f..8348bf5 100644
  bail2:
      FcStrSetDestroy (files);
 diff --git a/src/fcinit.c b/src/fcinit.c
-index 9c66515..f0a1e8e 100644
+index e68e1cb796eaf4a63071b9bb0e958b8bc1026541..515c26a8e1317e15ac277163b832c84b4481049e 100644
 --- a/src/fcinit.c
 +++ b/src/fcinit.c
 @@ -36,6 +36,12 @@
-- 
2.54.0.windows.1
