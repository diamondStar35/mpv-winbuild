+// Fade transport is confined to the core thread. The AO only advances its PCM
+// envelope and wakes the core at rendering completion; it never runs commands.
+bool audio_fade_set(struct MPContext *mpctx, double target, double seconds)
+{
+    if (!isfinite(target) || !isfinite(seconds) || target < 0 || target > 1 ||
+        seconds < 0 || seconds > 60)
+        return false;
+    bool applied = !mpctx->ao || ao_set_fade(mpctx->ao, target, seconds);
+    // Retain transport intent if an unsupported output is later replaced by a
+    // PCM device. Never carry a muted target into a subsequent resume.
+    mpctx->audio_fade_set = true;
+    mpctx->audio_fade_target = target;
+    mp_notify_property(mpctx, "audio-fade");
+    return applied;
+}
+
+void audio_fade_cancel(struct MPContext *mpctx, bool restore)
+{
+    bool owned = mpctx->audio_fade_transport_owned;
+    mpctx->audio_fade_action = AUDIO_FADE_NONE;
+    mpctx->audio_fade_transport_owned = false;
+    if (restore && owned)
+        audio_fade_set(mpctx, 1, 0);
+    mp_notify_property(mpctx, "audio-fade");
+}
+
+bool audio_fade_paused(struct MPContext *mpctx)
+{
+    switch (mpctx->audio_fade_action) {
+    case AUDIO_FADE_PAUSE:
+        return true;
+    case AUDIO_FADE_SEEK_OUT:
+    case AUDIO_FADE_SEEK_WAIT:
+        return mpctx->audio_fade_seek_paused;
+    case AUDIO_FADE_PLAY_WAIT:
+        return false;
+    default:
+        return mpctx->opts->pause;
+    }
+}
+
+static bool fade_can_render(struct MPContext *mpctx)
+{
+    return mpctx->ao && ao_can_fade(mpctx->ao) &&
+           mpctx->audio_status != STATUS_EOF;
+}
+
+static bool fade_waiting_for_seek(struct MPContext *mpctx)
+{
+    return mpctx->audio_fade_action == AUDIO_FADE_SEEK_OUT ||
+           mpctx->audio_fade_action == AUDIO_FADE_SEEK_WAIT ||
+           mpctx->audio_fade_action == AUDIO_FADE_PLAY_WAIT;
+}
+
+void audio_fade_pause(struct MPContext *mpctx, double seconds)
+{
+    if (fade_waiting_for_seek(mpctx)) {
+        mpctx->audio_fade_seek_paused = true;
+        if (mpctx->audio_fade_action != AUDIO_FADE_SEEK_OUT)
+            set_pause_state(mpctx, true);
+        // A refresh seek requested by fade-play can finish while remaining paused.
+        if (mpctx->audio_fade_action == AUDIO_FADE_PLAY_WAIT)
+            mpctx->audio_fade_action = AUDIO_FADE_SEEK_WAIT;
+    } else if (!mpctx->opts->pause) {
+        audio_fade_cancel(mpctx, false);
+        mpctx->audio_fade_transport_owned = true;
+        if (seconds > 0 && fade_can_render(mpctx)) {
+            mpctx->audio_fade_action = AUDIO_FADE_PAUSE;
+            audio_fade_set(mpctx, 0, seconds);
+        } else {
+            set_pause_state(mpctx, true);
+        }
+    }
+    mp_notify_property(mpctx, "audio-fade");
+    mp_wakeup_core(mpctx);
+}
+
+void audio_fade_play(struct MPContext *mpctx, double seconds)
+{
+    if (fade_waiting_for_seek(mpctx)) {
+        mpctx->audio_fade_seek_paused = false;
+        mp_notify_property(mpctx, "audio-fade");
+        mp_wakeup_core(mpctx);
+        return;
+    }
+
+    audio_fade_cancel(mpctx, false);
+    mpctx->audio_fade_transport_owned = true;
+    mpctx->audio_fade_seconds = seconds;
+    if (mpctx->opts->pause && seconds > 0 && fade_can_render(mpctx)) {
+        struct ao_fade_state state = ao_get_fade(mpctx->ao);
+        if (state.gain > 0 || state.active) {
+            // An external pause can retain already mixed, audible samples. Flush
+            // those while paused, without seeking on ordinary faded resumes.
+            double position = get_current_time(mpctx);
+            audio_fade_set(mpctx, 0, 0);
+            mpctx->audio_fade_action = AUDIO_FADE_PLAY_WAIT;
+            mpctx->audio_fade_seek_paused = false;
+            if (mpctx->demuxer && mpctx->demuxer->seekable &&
+                position != MP_NOPTS_VALUE) {
+                mpctx->audio_fade_seek_target = position;
+                queue_seek(mpctx, MPSEEK_ABSOLUTE, position, MPSEEK_EXACT, 0);
+            } else {
+                clear_audio_output_buffers(mpctx);
+                reset_audio_state(mpctx);
+                mpctx->restart_complete = false;
+            }
+            return;
+        }
+    }
+    // Arm before unpausing. A reversal starts at the current render-side gain,
+    // and a fully faded pause already has silent samples in the device queue.
+    audio_fade_set(mpctx, 1, seconds);
+    set_pause_state(mpctx, false);
+}
+
+bool audio_fade_seek(struct MPContext *mpctx, double target, double seconds,
+                     bool absolute)
+{
+    if (!mpctx->playback_initialized || !mpctx->demuxer || !isfinite(target) ||
+        !isfinite(seconds) || seconds < 0 || seconds > 60)
+        return false;
+    bool waiting = fade_waiting_for_seek(mpctx);
+    double position = waiting ? mpctx->audio_fade_seek_target : get_current_time(mpctx);
+    if (!absolute && position == MP_NOPTS_VALUE)
+        return false;
+    target = MPMAX(0, absolute ? target : position + target);
+    double length = get_time_length(mpctx);
+    if (length >= 0)
+        target = MPMIN(target, length);
+    bool paused = audio_fade_paused(mpctx);
+    mpctx->audio_fade_seek_target = target;
+    mpctx->audio_fade_seconds = seconds;
+    mpctx->audio_fade_seek_paused = paused;
+
+    if (mpctx->audio_fade_action == AUDIO_FADE_SEEK_OUT)
+        return true; // replace the destination without restarting the fade-out
+    if (waiting) {
+        mpctx->audio_fade_action = AUDIO_FADE_SEEK_WAIT;
+        queue_seek(mpctx, MPSEEK_ABSOLUTE, target, MPSEEK_EXACT, 0);
+        return true;
+    }
+    audio_fade_cancel(mpctx, false);
+    mpctx->audio_fade_transport_owned = true;
+    if (!paused && seconds > 0 && fade_can_render(mpctx)) {
+        mpctx->audio_fade_action = AUDIO_FADE_SEEK_OUT;
+        audio_fade_set(mpctx, 0, MPMIN(0.005, seconds));
+        mp_wakeup_core(mpctx);
+    } else {
+        // A paused seek must not resume playback. Unsupported outputs retain
+        // ordinary transport behavior, without modifying encoded audio packets.
+        if (fade_can_render(mpctx))
+            audio_fade_set(mpctx, paused ? 0 : 1, 0);
+        mpctx->audio_fade_action = AUDIO_FADE_SEEK_WAIT;
+        queue_seek(mpctx, MPSEEK_ABSOLUTE, target, MPSEEK_EXACT, 0);
+    }
+    mp_notify_property(mpctx, "audio-fade");
+    return true;
+}
+
+void audio_fade_update(struct MPContext *mpctx)
+{
+    enum audio_fade_action action = mpctx->audio_fade_action;
+    if (action != AUDIO_FADE_PAUSE && action != AUDIO_FADE_SEEK_OUT)
+        return;
+    if (mpctx->stop_play || !mpctx->playback_initialized) {
+        audio_fade_cancel(mpctx, true);
+        return;
+    }
+    if (fade_can_render(mpctx)) {
+        struct ao_fade_state state = ao_get_fade(mpctx->ao);
+        if (state.active) {
+            // The AO wakes us when rendering finishes. Only then schedule the
+            // single audible-completion deadline on the existing core dispatcher.
+            if (!state.rendering && !get_internal_paused(mpctx))
+                mp_set_timeout(mpctx, MPMAX(0,
+                    MP_TIME_NS_TO_S(state.end_time_ns - mp_time_ns())));
+            return;
+        }
+    }
+    audio_fade_set(mpctx, 0, 0);
+    if (action == AUDIO_FADE_PAUSE) {
+        mpctx->audio_fade_action = AUDIO_FADE_NONE;
+        set_pause_state(mpctx, true);
+    } else {
+        mpctx->audio_fade_action = AUDIO_FADE_SEEK_WAIT;
+        if (mpctx->audio_fade_seek_paused)
+            set_pause_state(mpctx, true);
+        queue_seek(mpctx, MPSEEK_ABSOLUTE, mpctx->audio_fade_seek_target,
+                   MPSEEK_EXACT, 0);
+    }
+    mp_notify_property(mpctx, "audio-fade");
+}
+
+void audio_fade_restart(struct MPContext *mpctx)
+{
+    if ((mpctx->audio_fade_action != AUDIO_FADE_SEEK_WAIT &&
+         mpctx->audio_fade_action != AUDIO_FADE_PLAY_WAIT) || mpctx->seek.type)
+        return;
+    bool paused = mpctx->audio_fade_seek_paused;
+    mpctx->audio_fade_action = AUDIO_FADE_NONE;
+    audio_fade_set(mpctx, paused ? 0 : 1, paused ? 0 : mpctx->audio_fade_seconds);
+    set_pause_state(mpctx, paused);
+    mp_notify_property(mpctx, "audio-fade");
+}
+
 // Call this if opts->playback_speed or mpctx->speed_factor_* change.
 void update_playback_speed(struct MPContext *mpctx)
 {
