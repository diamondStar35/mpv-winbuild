+
     double v = cmd->args[0].v.d * cmd->cmd->scale;
     int abs = cmd->args[1].v.i & 3;
     enum seek_precision precision = MPSEEK_DEFAULT;
@@ -7634,6 +7661,21 @@ const struct mp_cmd_def mp_cmds[] = {
             {"duration", OPT_DOUBLE(v.d), M_RANGE(0, 60)},
