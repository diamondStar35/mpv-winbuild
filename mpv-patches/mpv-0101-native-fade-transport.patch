+
+static void cmd_fade_pause(void *p)
+{
+    struct mp_cmd_ctx *cmd = p;
+    double seconds = cmd->args[0].v.d;
+    cmd->success = isfinite(seconds);
+    if (cmd->success)
+        audio_fade_pause(cmd->mpctx, seconds);
+}
+
+static void cmd_fade_play(void *p)
+{
+    struct mp_cmd_ctx *cmd = p;
+    double seconds = cmd->args[0].v.d;
+    cmd->success = isfinite(seconds);
+    if (cmd->success)
+        audio_fade_play(cmd->mpctx, seconds);
+}
+
+static void cmd_fade_seek(void *p)
+{
+    struct mp_cmd_ctx *cmd = p;
+    cmd->success = audio_fade_seek(cmd->mpctx, cmd->args[0].v.d,
+                                   cmd->args[1].v.d, cmd->args[2].v.i);
 }
 
 static void cmd_seek(void *p)
@@ -6049,6 +6074,8 @@ static void cmd_seek(void *p)
     struct mp_cmd_ctx *cmd = p;
     struct MPContext *mpctx = cmd->mpctx;
 
