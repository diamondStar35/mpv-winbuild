+struct ao_crossfade_state ao_get_crossfade(struct ao *ao)
+{
+    struct buffer_state *p = ao->buffer_state;
+    mp_mutex_lock(&p->lock);
+    int frames = p->crossfade_frames - p->crossfade_position;
+    int64_t available = mp_async_queue_get_samples(p->queue);
+    if (p->pending)
+        available += mp_aframe_get_size(p->pending);
+    int64_t now = p->crossfade_paused_ns ? p->crossfade_paused_ns : mp_time_ns();
+    double queued = MPMAX(0, MP_TIME_NS_TO_S(p->crossfade_end_ns - now));
+    struct ao_crossfade_state state = {
+        .active = frames > 0 || queued > 0,
+        .waiting = frames > 0 && p->crossfade_waiting,
+        .remaining = frames / (double)ao->samplerate + queued,
+        .available = available / (double)ao->samplerate,
+        .supported = ao_can_fade(ao) && !ao->driver->write_frames && !ao->encode_lavc_ctx,
+    };
+    mp_mutex_unlock(&p->lock);
+    return state;
+}
+
+double ao_crossfade_capture(struct ao *ao, double seconds, bool equal_power)
+{
+    if (!ao_can_fade(ao) || ao->driver->write_frames || !isfinite(seconds) ||
+        seconds <= 0 || seconds > 30)
+        return 0;
+    // Bound retained memory independently of sample rate and channel count.
+    size_t frame_bytes = (size_t)ao->sstride * ao->num_planes;
+    int frames = MPMIN(seconds * ao->samplerate, AO_CROSSFADE_MAX_BYTES / frame_bytes);
+    if (frames <= 0)
+        return 0;
+    size_t plane_size = (size_t)frames * ao->sstride;
+    uint8_t *storage = talloc_size(ao, plane_size * ao->num_planes);
+    // Commit pages outside the output lock; the audio callback never allocates.
+    memset(storage, 0, plane_size * ao->num_planes);
+    void *planes[MP_NUM_CHANNELS];
+    for (int n = 0; n < ao->num_planes; n++)
+        planes[n] = storage + plane_size * n;
+    struct buffer_state *p = ao->buffer_state;
+    mp_mutex_lock(&p->lock);
+    int captured = 0;
+    if (p->playing && !p->paused &&
+        p->crossfade_position == p->crossfade_frames && p->crossfade_end_ns <= mp_time_ns()) {
+        bool eof;
+        captured = read_buffer(ao, planes, frames, &eof, false, 0, false);
+    }
+    if (captured > 0) {
+        TA_FREEP(&p->crossfade_data);
+        p->crossfade_data = storage;
+        p->crossfade_plane_size = plane_size;
+        p->crossfade_frames = captured;
+        p->crossfade_position = 0;
+        p->crossfade_progress = 0;
+        p->crossfade_length = captured;
+        p->crossfade_start_gain = 1;
+        p->crossfade_waiting = true;
+        p->crossfade_mixing = false;
+        p->crossfade_equal_power = equal_power;
+        p->crossfade_track_gain = ao_get_track_gain(ao);
+        p->crossfade_end_ns = 0;
+        TA_FREEP(&p->pending);
+        mp_async_queue_reset(p->queue);
+        mp_filter_reset(p->filter_root);
+        mp_async_queue_resume_reading(p->queue);
+    }
+    mp_mutex_unlock(&p->lock);
+    if (!captured)
+        talloc_free(storage);
+    return captured / (double)ao->samplerate;
+}
+
+void ao_crossfade_commit(struct ao *ao, double max_seconds)
+{
+    struct buffer_state *p = ao->buffer_state;
+    mp_mutex_lock(&p->lock);
+    if (isfinite(max_seconds) && max_seconds > 0) {
+        int remaining = p->crossfade_frames - p->crossfade_position;
+        int frames = MPMIN(remaining, max_seconds * ao->samplerate);
+        if (frames < remaining) {
+            p->crossfade_start_gain = crossfade_gain(p);
+            p->crossfade_length = frames;
+            p->crossfade_progress = 0;
+        }
+        p->crossfade_frames = p->crossfade_position + frames;
+    }
+    p->crossfade_waiting = false;
+    mp_mutex_unlock(&p->lock);
+    ao_wakeup(ao);
+}
+
+void ao_crossfade_clear_input(struct ao *ao)
+{
+    struct buffer_state *p = ao->buffer_state;
+    mp_mutex_lock(&p->lock);
+    // An initial seek for the incoming file only discards its producer data.
+    // The outgoing reserve and already queued hardware samples keep playing.
+    TA_FREEP(&p->pending);
+    mp_async_queue_reset(p->queue);
+    mp_filter_reset(p->filter_root);
+    mp_async_queue_resume_reading(p->queue);
+    mp_mutex_unlock(&p->lock);
+}
