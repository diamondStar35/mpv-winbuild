+static double crossfade_gain(struct buffer_state *p)
+{
+    if (!p->crossfade_length)
+        return 0;
+    double phase = MPMIN(1.0, p->crossfade_progress / (double)p->crossfade_length);
+    return p->crossfade_start_gain *
+        (p->crossfade_equal_power ? cos(phase * M_PI / 2) : 1 - phase);
+}
+
+// called locked; does not allocate, free storage or wait for the next decoder
+static int prepare_crossfade(struct ao *ao, int incoming, int samples,
+                             int64_t start_time_ns, struct ao_crossfade_mix *mix)
+{
+    struct buffer_state *p = ao->buffer_state;
+    int remaining = p->crossfade_frames - p->crossfade_position;
+    if (!p->playing || p->paused || remaining <= 0)
+        return incoming;
+    if (incoming && !p->crossfade_mixing) {
+        p->crossfade_start_gain = crossfade_gain(p);
+        p->crossfade_mixing = true;
+        p->crossfade_length = remaining;
+        p->crossfade_progress = 0;
+    }
+    int count = MPMIN(samples, remaining);
+    *mix = (struct ao_crossfade_mix){
+        .data = p->crossfade_data,
+        .plane_size = p->crossfade_plane_size,
+        .position = p->crossfade_position,
+        .frames = count,
+        .incoming = incoming,
+        .length = p->crossfade_length,
+        .progress = p->crossfade_progress,
+        .mixing = p->crossfade_mixing,
+        .equal_power = p->crossfade_equal_power,
+        .track_gain = p->crossfade_track_gain,
+        .start_gain = p->crossfade_start_gain,
+    };
+    p->crossfade_position += count;
+    p->crossfade_progress += count;
+    if (p->crossfade_position == p->crossfade_frames) {
+        p->crossfade_end_ns = start_time_ns + (int64_t)(count * 1e9 / ao->samplerate);
+        p->crossfade_waiting = false;
+        ao->wakeup_cb(ao->wakeup_ctx);
+    }
+    return MPMAX(incoming, count);
+}
