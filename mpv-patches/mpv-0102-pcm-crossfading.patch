+static void cmd_crossfade_loadfile(void *p)
+{
+    struct mp_cmd_ctx *cmd = p;
+    MPContext *mpctx = cmd->mpctx;
+    double seconds = cmd->args[1].v.d;
+    if (!isfinite(seconds)) {
+        cmd->success = false;
+        return;
+    }
+    if (mpctx->opts->position_save_on_quit)
+        mp_write_watch_later_conf(mpctx);
+    char *path = mp_get_user_path(NULL, mpctx->global, cmd->args[0].v.s);
+    struct playlist_entry *entry = playlist_entry_new(path);
+    talloc_free(path);
+    char **pairs = cmd->args[3].v.str_list;
+    for (int i = 0; pairs && pairs[i] && pairs[i + 1]; i += 2)
+        playlist_entry_add_param(entry, bstr0(pairs[i]), bstr0(pairs[i + 1]));
+
+    double captured = 0;
+    if (mpctx->ao && !get_internal_paused(mpctx) && !mpctx->encode_lavc_ctx)
+        captured = ao_crossfade_capture(mpctx->ao, seconds, cmd->args[2].v.i);
+    audio_fade_cancel(mpctx, false);
+    audio_fade_set(mpctx, 1, captured > 0 ? MPMIN(0.005, seconds) : 0);
+    playlist_clear(mpctx->playlist);
+    playlist_insert_at(mpctx->playlist, entry, NULL);
+    mpctx->audio_crossfade_entry_id = captured > 0 ? entry->id : 0;
+    mp_set_playlist_entry(mpctx, entry);
+
+    node_init(&cmd->result, MPV_FORMAT_NODE_MAP, NULL);
+    node_map_add_int64(&cmd->result, "playlist_entry_id", entry->id);
+    node_map_add_double(&cmd->result, "captured", captured);
+    mp_notify(mpctx, MP_EVENT_CHANGE_PLAYLIST, NULL);
+    mp_notify_property(mpctx, "audio-crossfade");
+    mp_wakeup_core(mpctx);
+}
