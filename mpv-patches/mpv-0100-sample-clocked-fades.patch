+static void cmd_audio_fade(void *p)
+{
+    struct mp_cmd_ctx *cmd = p;
+    MPContext *mpctx = cmd->mpctx;
+    double target = cmd->args[0].v.d;
+    double seconds = cmd->args[1].v.d;
+    if (!isfinite(target) || !isfinite(seconds) ||
+        (mpctx->ao && !ao_set_fade(mpctx->ao, target, seconds))) {
+        cmd->success = false;
+        return;
+    }
+    mpctx->audio_fade_set = true;
+    mpctx->audio_fade_target = target;
+    mp_notify_property(mpctx, "audio-fade");
+}
