 static struct ao *ao_alloc(bool probing, struct mpv_global *global,
                            void (*wakeup_cb)(void *ctx), void *wakeup_ctx,
                            char *name)
@@ -188,6 +195,9 @@ static struct ao *ao_alloc(bool probing, struct mpv_global *global,
         .client_name = talloc_strdup(ao, opts->audio_client_name),
         .set_media_role = opts->audio_set_media_role
     };
+    mp_mutex_init(&ao->fade_lock);
+    talloc_set_destructor(ao, destroy_ao);
+    ao->fade_gain = ao->fade_target = 1;
     talloc_free(opts);
     ao->priv = m_config_group_from_desc(ao, ao->log, global, &desc, name);
     if (!ao->priv)
@@ -615,50 +625,146 @@ void ao_set_gain(struct ao *ao, float gain)
     atomic_store(&ao->gain, gain);
 }
 
-#define MUL_GAIN_i(d, num_samples, gain, low, center, high)                     \
-    for (int n = 0; n < (num_samples); n++)                                     \
-        (d)[n] = MPCLAMP(                                                       \
-            ((((int64_t)((d)[n]) - (center)) * (gain) + 128) >> 8) + (center),  \
-            (low), (high))
+bool ao_can_fade(struct ao *ao)
+{
+    switch (af_fmt_from_planar(ao->format)) {
+    case AF_FORMAT_U8:
+    case AF_FORMAT_S16:
+    case AF_FORMAT_S32:
+    case AF_FORMAT_FLOAT:
+    case AF_FORMAT_DOUBLE:
+        return true;
+    default:
+        return false;
+    }
+}
 
-#define MUL_GAIN_f(d, num_samples, gain)                                        \
-    for (int n = 0; n < (num_samples); n++)                                     \
-        (d)[n] = (d)[n] * (gain)
+bool ao_set_fade(struct ao *ao, double target, double seconds)
+{
+    if (!ao_can_fade(ao) || !isfinite(target) || !isfinite(seconds) ||
+        target < 0 || target > 1 || seconds < 0 || seconds > 60)
+        return false;
 
-static void process_plane(struct ao *ao, void *data, int num_samples)
+    mp_mutex_lock(&ao->fade_lock);
+    // Duration describes a full-range ramp. Reversals keep the same slope.
+    ao->fade_remaining = llrint(seconds * fabs(target - ao->fade_gain) *
+                               ao->samplerate);
+    bool changes_gain = target != ao->fade_gain || ao->fade_remaining;
+    ao->fade_target = target;
+    if (!ao->fade_remaining)
+        ao->fade_gain = target;
+    // Reissuing an already reached target must still wait for queued ramp
+    // samples. Otherwise cancelling a completed fade can pause the AO early.
+    if (changes_gain)
+        ao->fade_end_ns = 0;
+    mp_mutex_unlock(&ao->fade_lock);
+    return true;
+}
+
+struct ao_fade_state ao_get_fade(struct ao *ao)
+{
+    mp_mutex_lock(&ao->fade_lock);
+    int64_t now = ao->fade_paused_ns ? ao->fade_paused_ns : mp_time_ns();
+    struct ao_fade_state state = {
+        .gain = ao->fade_gain,
+        .target = ao->fade_target,
+        .active = ao->fade_remaining > 0 || ao->fade_end_ns > now,
+    };
+    mp_mutex_unlock(&ao->fade_lock);
+    return state;
+}
+
+void ao_reset_fade_clock(struct ao *ao)
+{
+    mp_mutex_lock(&ao->fade_lock);
+    ao->fade_end_ns = 0;
+    mp_mutex_unlock(&ao->fade_lock);
+}
+
+void ao_pause_fade_clock(struct ao *ao, bool paused)
+{
+    mp_mutex_lock(&ao->fade_lock);
+    int64_t now = mp_time_ns();
+    if (paused && !ao->fade_paused_ns) {
+        ao->fade_paused_ns = now;
+    } else if (!paused && ao->fade_paused_ns) {
+        if (ao->fade_end_ns > ao->fade_paused_ns)
+            ao->fade_end_ns += now - ao->fade_paused_ns;
+        ao->fade_paused_ns = 0;
+    }
+    mp_mutex_unlock(&ao->fade_lock);
+}
+
+// Every plane uses the same envelope snapshot. Interleaved channels share one
+// gain per frame, and integer output is rounded only after multiplying samples.
+#define FADE_SAMPLES(type, expression)                                         \
+    do {                                                                     \
+        type *d = data;                                                      \
+        for (int n = 0; n < frames; n++) {                                    \
+            double fraction = remaining ?                                   \
+                MPMIN((double)n + 1, (double)remaining) / remaining : 1;      \
+            double gain = volume * (start + (target - start) * fraction);     \
+            for (int c = 0; c < channels; c++) {                              \
+                double sample = d[n * channels + c];                         \
+                d[n * channels + c] = (expression);                          \
+            }                                                               \
+        }                                                                   \
+    } while (0)
+
+static void process_plane(struct ao *ao, void *data, int frames, int channels,
+                          double volume, double start, double target,
+                          int64_t remaining)
 {
-    float gain = atomic_load_explicit(&ao->gain, memory_order_relaxed);
-    int gi = lrint(256.0 * gain);
-    if (gi == 256)
-        return;
     switch (af_fmt_from_planar(ao->format)) {
     case AF_FORMAT_U8:
-        MUL_GAIN_i((uint8_t *)data, num_samples, gi, 0, 128, 255);
+        FADE_SAMPLES(uint8_t, llrint(MPCLAMP((sample - 128) * gain + 128, 0, 255)));
         break;
     case AF_FORMAT_S16:
-        MUL_GAIN_i((int16_t *)data, num_samples, gi, INT16_MIN, 0, INT16_MAX);
+        FADE_SAMPLES(int16_t, llrint(MPCLAMP(sample * gain, INT16_MIN, INT16_MAX)));
         break;
     case AF_FORMAT_S32:
-        MUL_GAIN_i((int32_t *)data, num_samples, gi, INT32_MIN, 0, INT32_MAX);
+        FADE_SAMPLES(int32_t, llrint(MPCLAMP(sample * gain, INT32_MIN, INT32_MAX)));
         break;
     case AF_FORMAT_FLOAT:
-        MUL_GAIN_f((float *)data, num_samples, gain);
+        FADE_SAMPLES(float, sample * gain);
         break;
     case AF_FORMAT_DOUBLE:
-        MUL_GAIN_f((double *)data, num_samples, gain);
+        FADE_SAMPLES(double, sample * gain);
         break;
     default:;
         // all other sample formats are simply not supported
     }
 }
 
-void ao_post_process_data(struct ao *ao, void **data, int num_samples)
+void ao_post_process_data(struct ao *ao, void **data, int num_samples,
+                          int64_t out_time_ns)
 {
+    if (!num_samples || !ao_can_fade(ao))
+        return;
+    double volume = atomic_load_explicit(&ao->gain, memory_order_relaxed);
+    mp_mutex_lock(&ao->fade_lock);
     bool planar = af_fmt_is_planar(ao->format);
     int planes = planar ? ao->channels.num : 1;
-    int plane_samples = num_samples * (planar ? 1: ao->channels.num);
-    for (int n = 0; n < planes; n++)
-        process_plane(ao, data[n], plane_samples);
+    int channels = planar ? 1 : ao->channels.num;
+    if (volume != 1 || ao->fade_gain != 1 || ao->fade_remaining) {
+        for (int n = 0; n < planes; n++)
+            process_plane(ao, data[n], num_samples, channels, volume,
+                          ao->fade_gain, ao->fade_target, ao->fade_remaining);
+    }
+    if (ao->fade_remaining) {
+        int64_t count = MPMIN(ao->fade_remaining, num_samples);
+        ao->fade_gain += (ao->fade_target - ao->fade_gain) *
+                         count / ao->fade_remaining;
+        ao->fade_remaining -= count;
+        if (!ao->fade_remaining) {
+            ao->fade_gain = ao->fade_target;
+            // Rendering completion is not audible completion: the last ramp
+            // sample may still be queued in the hardware output buffer.
+            ao->fade_end_ns = out_time_ns -
+                (int64_t)((num_samples - count) * 1e9 / ao->samplerate);
+        }
+    }
+    mp_mutex_unlock(&ao->fade_lock);
 }
 
 static int get_conv_type(struct ao_convert_fmt *fmt)
