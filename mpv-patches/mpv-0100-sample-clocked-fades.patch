+static int mp_property_audio_fade(void *ctx, struct m_property *prop,
+                                 int action, void *arg)
+{
+    MPContext *mpctx = ctx;
+    double gain = mpctx->audio_fade_set ? mpctx->audio_fade_target : 1;
+    struct ao_fade_state state = {.gain = gain, .target = gain};
+    bool supported = mpctx->ao && ao_can_fade(mpctx->ao);
+    if (mpctx->ao)
+        state = ao_get_fade(mpctx->ao);
+    struct m_sub_property props[] = {
