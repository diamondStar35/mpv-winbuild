+void mp_output_chain_set_gapless(struct mp_output_chain *c, bool gapless)
+{
+    struct chain *p = c->f->priv;
+    if (p->gapless != gapless) {
+        p->gapless = gapless;
+        mp_autoconvert_clear(p->input_convert);
+    }
+}
