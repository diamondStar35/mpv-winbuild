+void ao_crossfade_reserve(struct ao *ao, double seconds)
+{
+    struct buffer_state *p = ao->buffer_state;
+    size_t frame_bytes = (size_t)ao->sstride * ao->num_planes;
+    int reserve = (int)MPMIN(seconds * ao->samplerate,
+                            AO_CROSSFADE_MAX_BYTES / frame_bytes);
+    struct mp_async_queue_config cfg = {
+        .sample_unit = AQUEUE_UNIT_SAMPLES,
+        .max_samples = MPMAX(ao->buffer, reserve),
+        .max_bytes = INT64_MAX,
+    };
+    // Changing capacity wakes the producer without dropping queued samples or
+    // rebuilding the device. Ordinary playback keeps its normal short buffer.
+    mp_async_queue_set_config(p->queue, cfg);
+}
+
 struct ao_crossfade_state ao_get_crossfade(struct ao *ao)
 {
     struct buffer_state *p = ao->buffer_state;
