+void mp_output_chain_new_stream(struct mp_output_chain *c)
+{
+    struct chain *p = c->f->priv;
+    mp_filter_new_stream(p->f);
+    p->public.failed_output_conversion = false;
+    for (int n = 0; n < p->num_all_filters; n++)
+        p->all_filters[n]->failed = false;
+    mp_autoconvert_clear(p->input_convert);
+    mp_aframe_reset(p->output->last_in_aformat);
+    p->ao = NULL;
+    mp_autoconvert_clear(p->convert);
