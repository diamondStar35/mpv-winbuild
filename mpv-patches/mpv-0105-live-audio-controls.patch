 static void output_chain_destroy(struct mp_filter *f)
 {
     output_chain_reset(f);
@@ -726,9 +752,38 @@ static void create_video_things(struct chain *p)
     MP_TARRAY_APPEND(p, p->post_filters, p->num_post_filters, f);
 }
 
+static void on_input_format_change(void *opaque)
+{
+    struct chain *p = opaque;
+    struct mp_aframe *src = p->input->last_in_aformat;
+
+    mp_autoconvert_clear(p->input_convert);
+    if (p->gapless && af_fmt_is_pcm(mp_aframe_get_format(src))) {
+        // A stable, lossless PCM representation prevents bit-depth changes
+        // from rebuilding the DSP graph. Rates and channels follow each source;
+        // pinning them to the first decoder could discard later track content.
+        mp_autoconvert_add_afmt(p->input_convert, AF_FORMAT_DOUBLEP);
+    }
+    mp_autoconvert_format_change_continue(p->input_convert);
+}
+
+static void create_audio_input(struct chain *p)
+{
+    struct mp_user_filter *u = create_wrapper_filter(p);
+    u->name = "input-format";
+    p->input_convert = mp_autoconvert_create(u->wrapper);
+    if (!p->input_convert)
+        abort();
+    u->f = p->input_convert->f;
+    p->input_convert->on_audio_format_change = on_input_format_change;
+    p->input_convert->on_audio_format_change_opaque = p;
+    MP_TARRAY_APPEND(p, p->pre_filters, p->num_pre_filters, u);
+}
+
 static void create_audio_things(struct chain *p)
 {
     p->frame_type = MP_FRAME_AUDIO;
+    create_audio_input(p);
 
     struct mp_user_filter *f = create_wrapper_filter(p);
     f->name = "userspeed";
