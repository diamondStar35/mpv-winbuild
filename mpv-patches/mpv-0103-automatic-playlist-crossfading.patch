+static bool automatic_crossfade_enabled(struct MPContext *mpctx)
+{
+    struct MPOpts *opts = mpctx->opts;
+    double ab[2];
+    if (opts->ao_opts->audio_crossfade_duration <= 0 || !mpctx->playback_initialized ||
+        mpctx->stop_play || !mpctx->ao_chain || !mpctx->ao ||
+        mpctx->encode_lavc_ctx || !ao_can_fade(mpctx->ao) ||
+        opts->keep_open == 2 || mpctx->play_dir < 0 || mpctx->max_frames >= 0 ||
+        opts->step_sec > 0 || mpctx->remaining_file_loops ||
+        get_ab_loop_times(mpctx, ab) || get_play_end_pts(mpctx) != MP_NOPTS_VALUE ||
+        (mpctx->vo_chain && !mpctx->vo_chain->is_coverart) ||
+        !mpctx->playing || mpctx->playlist->current != mpctx->playing ||
+        mpctx->playlist->current_was_replaced || mpctx->playing->init_failed)
+        return false;
+
+    struct playlist_entry *next = playlist_get_next(mpctx->playlist, 1);
+    // Do not mutate shuffle order or consume a playlist loop just to inspect
+    // eligibility. mp_next_file() makes that decision once at the handoff.
+    bool successor = next ? !next->init_failed :
+        opts->loop_times != 1 && mpctx->playlist->num_entries > 1;
+    return successor && ao_get_crossfade(mpctx->ao).supported;
+}
+
+void audio_crossfade_update(struct MPContext *mpctx)
+{
+    if (!automatic_crossfade_enabled(mpctx) || !mpctx->restart_complete ||
+        get_internal_paused(mpctx) || audio_fade_paused(mpctx) || mpctx->seek.type ||
+        mpctx->audio_fade_action != AUDIO_FADE_NONE || mpctx->audio_crossfade_entry_id)
+        return;
+
+    // Reuse mpv's demux prefetcher as soon as a successor is queued. The
+    // incoming decoder is opened while retained outgoing PCM is playing.
+    prefetch_next(mpctx);
+    if (!mpctx->ao_chain->out_eof || !mpctx->ao_chain->ao_queue ||
+        !mp_async_queue_has_eof(mpctx->ao_chain->ao_queue))
+        return;
+
+    struct ao_crossfade_state state = ao_get_crossfade(mpctx->ao);
+    if (!state.supported || state.active || state.available <= 0 ||
+        ao_get_fade(mpctx->ao).active)
+        return;
+    double seconds = MPMIN(mpctx->opts->ao_opts->audio_crossfade_duration, state.capacity);
+    if (state.available > seconds) {
+        // A caller may have configured a larger ordinary audio buffer. Wait
+        // for the final overlap window without polling a clock in the client.
+        mp_set_timeout(mpctx, state.available - seconds);
+        return;
+    }
+
+    struct playlist_entry *preview = mp_next_file(mpctx, 1, false, false);
+    if (preview && mpctx->open_active && mpctx->open_for_prefetch &&
+        atomic_load(&mpctx->open_done) && !mpctx->open_res_demuxer &&
+        strcmp(mpctx->open_url, preview->filename) == 0)
+        return; // let ordinary EOF retry an unavailable successor
+
+    double captured = ao_crossfade_capture(mpctx->ao, seconds,
+        mpctx->opts->ao_opts->audio_crossfade_curve != 0, true);
+    if (captured <= 0)
+        return;
+    struct playlist_entry *next = mp_next_file(mpctx, 1, false, true);
+    if (!next) {
+        // Keep the captured audio playable if no successor is available.
+        ao_crossfade_commit(mpctx->ao, 0);
+        return;
+    }
+    audio_fade_cancel(mpctx, false);
+    mpctx->audio_crossfade_auto_from = mpctx->playing->id;
+    mpctx->audio_crossfade_entry_id = next->id;
+    mp_set_playlist_entry(mpctx, next);
+    mp_notify_property(mpctx, "audio-crossfade");
+}
+
