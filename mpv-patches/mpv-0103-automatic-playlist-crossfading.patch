             mpctx->audio_status = STATUS_EOF;
@@ -1239,6 +1315,7 @@ void clear_audio_output_buffers(struct MPContext *mpctx)
         return;
     }
     mpctx->audio_crossfade_entry_id = 0;
+    mpctx->audio_crossfade_auto_from = 0;
     if (mpctx->ao)
         ao_reset(mpctx->ao);
 }
