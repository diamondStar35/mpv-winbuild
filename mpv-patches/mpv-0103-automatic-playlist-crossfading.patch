+    int end_reason = mpctx->stop_play;
+    if (mpctx->audio_crossfade_auto_from &&
+        mpctx->audio_crossfade_auto_from == end_event.playlist_entry_id &&
+        audio_crossfade_handoff(mpctx))
+        end_reason = AT_END_OF_FILE;
+    switch (end_reason) {
     case PT_ERROR:
     case AT_END_OF_FILE:
     {
@@ -2198,6 +2217,7 @@ terminate_playback:
     case PT_QUIT:           end_event.reason = MPV_END_FILE_REASON_QUIT; break;
     };
     mp_notify(mpctx, MPV_EVENT_END_FILE, &end_event);
+    mpctx->audio_crossfade_auto_from = 0;
 
