-        if (!ao_c->ao || (!ao_is_playing(ao_c->ao) || opts->gapless_audio))
+        if (!ao_c->ao || (!ao_is_playing(ao_c->ao) ||
+            (opts->gapless_audio && !automatic_crossfade_enabled(mpctx))))
         {
