From 7d6b07e8254d6cc63665c4f07eb4ddd97582441a Mon Sep 17 00:00:00 2001
From: diamondStar35 <ramymaherali55@gmail.com>
Date: Tue, 27 Oct 2026 13:25:06 +0300
Subject: [PATCH] packages: share a lean library-only media configuration

---
 cmake/packages_check.cmake |  6 +----
 packages/CMakeLists.txt    |  1 +
 packages/ffmpeg.cmake      | 50 ++++++++++++++++++++++++++++++--------
 packages/mpv.cmake         | 48 ++++++++++++++----------------------
 4 files changed, 60 insertions(+), 45 deletions(-)

diff --git a/cmake/packages_check.cmake b/cmake/packages_check.cmake
index e062242..0154cf5 100644
--- a/cmake/packages_check.cmake
+++ b/cmake/packages_check.cmake
@@ -7,11 +7,7 @@ if(COMPILER_TOOLCHAIN STREQUAL "gcc")
     set(ffmpeg_extra_libs "-lstdc++")
     set(libjxl_unaligned_vector "-Wa,-muse-unaligned-vector-move") # fix crash on AVX2 proc (64bit) due to unaligned stack memory
     set(mpv_copy_debug COMMAND ${CMAKE_COMMAND} -E copy <BINARY_DIR>/mpv.debug ${CMAKE_CURRENT_BINARY_DIR}/mpv-debug/mpv.debug)
-    set(mpv_add_debuglink COMMAND ${EXEC} ${TARGET_ARCH}-objcopy --only-keep-debug <BINARY_DIR>/mpv.exe <BINARY_DIR>/mpv.debug
-                          COMMAND ${EXEC} ${TARGET_ARCH}-strip -s <BINARY_DIR>/mpv.exe
-                          COMMAND ${EXEC} ${TARGET_ARCH}-objcopy --add-gnu-debuglink=<BINARY_DIR>/mpv.debug <BINARY_DIR>/mpv.exe
-                          COMMAND ${EXEC} ${TARGET_ARCH}-strip -s <BINARY_DIR>/mpv.com
-                          COMMAND ${EXEC} ${TARGET_ARCH}-strip -s <BINARY_DIR>/libmpv-2.dll)
+    set(mpv_add_debuglink COMMAND ${EXEC} ${TARGET_ARCH}-strip -s <BINARY_DIR>/libmpv-2.dll)
 elseif(COMPILER_TOOLCHAIN STREQUAL "clang")
     set(rust_target "gnullvm")
     set(vapoursynth_pkgconfig_libs "-lVapourSynth -Wl,-delayload=VapourSynth.dll")
diff --git a/packages/CMakeLists.txt b/packages/CMakeLists.txt
index e8cc1fe..42c94cb 100644
--- a/packages/CMakeLists.txt
+++ b/packages/CMakeLists.txt
@@ -124,6 +124,7 @@ message(STATUS "Parsing ${ep_length} packages")
 
 # Exclude packages which dont depend on mpv when update
 list(APPEND removed "flac" "opusfile" "libopusenc" "opus-tools" "termcap" "readline" "cryptopp" "sqlite" "libuv" "libsodium" "megasdk" "libsixel" "curl" "libressl" "mbedtls" "nettle" "gmp")
+list(APPEND removed "aom" "avisynth-headers" "libsdl2" "libsixel" "luajit" "mujs" "openal-soft" "rubberband" "vapoursynth")
 list(REMOVE_ITEM repo ${removed})
 list(REMOVE_ITEM ep ${removed})
 list(TRANSFORM repo APPEND "-force-update" OUTPUT_VARIABLE update)
diff --git a/packages/ffmpeg.cmake b/packages/ffmpeg.cmake
index b2a096c..ec2d5a4 100644
--- a/packages/ffmpeg.cmake
+++ b/packages/ffmpeg.cmake
@@ -1,7 +1,6 @@
 ExternalProject_Add(ffmpeg
     DEPENDS
         amf-headers
-        avisynth-headers
         nvcodec-headers
         bzip2
         lame
@@ -35,15 +34,11 @@ ExternalProject_Add(ffmpeg
         libplacebo
         libzvbi
         libaribcaption
-        aom
         svtav1
         dav1d
-        vapoursynth
         ${ffmpeg_uavs3d}
         ${ffmpeg_davs2}
-        rubberband
         libva
-        openal-soft
     GIT_REPOSITORY https://github.com/FFmpeg/FFmpeg.git
     SOURCE_DIR ${SOURCE_LOCATION}
     GIT_CLONE_FLAGS "--sparse --filter=tree:0"
@@ -59,8 +54,8 @@ ExternalProject_Add(ffmpeg
         --enable-runtime-cpudetect
         --enable-gpl
         --enable-version3
-        --enable-avisynth
-        --enable-vapoursynth
+        --disable-avisynth
+        --disable-vapoursynth
         --enable-libass
         --enable-libbluray
         --enable-libdvdnav
@@ -78,12 +73,12 @@ ExternalProject_Add(ffmpeg
         --enable-libspeex
         --enable-libvorbis
         --enable-libbs2b
-        --enable-librubberband
+        --disable-librubberband
         --enable-libvpx
         --enable-libwebp
         --enable-libx264
         --enable-libx265
-        --enable-libaom
+        --disable-libaom
         --enable-libsvtav1
         --enable-libdav1d
         ${ffmpeg_davs2_cmd}
@@ -104,7 +99,8 @@ ExternalProject_Add(ffmpeg
         --enable-nvdec
         --enable-nvenc
         --enable-amf
-        --enable-openal
+        --disable-openal
+        --disable-sdl2
         --disable-doc
         --disable-ffplay
         --disable-ffprobe
@@ -113,6 +109,40 @@ ExternalProject_Add(ffmpeg
         --disable-videotoolbox
         --disable-vulkan
         --disable-libplacebo # vf_libplacebo needs Vulkan; configure honours the last --enable/--disable
+        # Match LGPL native filters even when GPL codecs and disc readers are enabled.
+        --disable-filter=blackframe
+        --disable-filter=boxblur
+        --disable-filter=boxblur_opencl
+        --disable-filter=colormatrix
+        --disable-filter=cover_rect
+        --disable-filter=cropdetect
+        --disable-filter=delogo
+        --disable-filter=eq
+        --disable-filter=find_rect
+        --disable-filter=fspp
+        --disable-filter=histeq
+        --disable-filter=hqdn3d
+        --disable-filter=interlace
+        --disable-filter=kerndeint
+        --disable-filter=mcdeint
+        --disable-filter=mpdecimate
+        --disable-filter=mptestsrc
+        --disable-filter=nnedi
+        --disable-filter=owdenoise
+        --disable-filter=perspective
+        --disable-filter=phase
+        --disable-filter=pp7
+        --disable-filter=pullup
+        --disable-filter=repeatfields
+        --disable-filter=sab
+        --disable-filter=signature
+        --disable-filter=smartblur
+        --disable-filter=spp
+        --disable-filter=stereo3d
+        --disable-filter=super2xsai
+        --disable-filter=tinterlace
+        --disable-filter=uspp
+        --disable-filter=vaguedenoiser
         --disable-decoder=libaom_av1
         ${ffmpeg_lto}
         --extra-cflags='-Wno-error=int-conversion'
diff --git a/packages/mpv.cmake b/packages/mpv.cmake
index 628dd05..eb9ae4b 100644
--- a/packages/mpv.cmake
+++ b/packages/mpv.cmake
@@ -1,3 +1,4 @@
+set(MPV_PACKAGE_SUFFIX "" CACHE STRING "Library package variant suffix")
 ExternalProject_Add(mpv
     DEPENDS
         angle-headers
@@ -11,18 +12,11 @@ ExternalProject_Add(mpv
         libiconv
         libjpeg
         libpng
-        luajit
-        rubberband
         uchardet
-        openal-soft
-        mujs
         shaderc
         libplacebo
         spirv-cross
-        vapoursynth
-        libsdl2
         subrandr
-        libsixel
         curl
     GIT_REPOSITORY https://github.com/mpv-player/mpv.git
     SOURCE_DIR ${SOURCE_LOCATION}
@@ -40,23 +34,29 @@ ExternalProject_Add(mpv
         -Doptimization=3
         -Db_lto=true
         ${mpv_lto_mode}
+        -Dcplayer=false
+        -Dgpl=true
+        -Ddirect3d=disabled
         -Dlibmpv=true
-        -Dpdf-build=enabled
-        -Dlua=enabled
-        -Djavascript=enabled
-        -Dsdl2-gamepad=enabled
+        -Dpdf-build=disabled
+        -Dlua=disabled
+        -Djavascript=disabled
+        -Dsdl2-gamepad=disabled
+        -Dsdl2-audio=disabled
+        -Dsdl2-video=disabled
         -Dlibarchive=enabled
         -Dlibbluray=enabled
+        -Ddvda=enabled
         -Ddvdnav=enabled
         -Duchardet=enabled
-        -Drubberband=enabled
+        -Drubberband=disabled
         -Dlcms2=enabled
-        -Dopenal=enabled
+        -Dopenal=disabled
         -Dspirv-cross=enabled
         -Dvulkan=disabled
-        -Dvapoursynth=enabled
+        -Dvapoursynth=disabled
         -Dsubrandr=enabled
-        -Dsixel=enabled
+        -Dsixel=disabled
         ${mpv_gl}
         -Dlibcurl=enabled
         -Dc_args='-Wno-error=int-conversion'
@@ -73,20 +73,13 @@ ExternalProject_Add_Step(mpv strip-binary
 
 ExternalProject_Add_Step(mpv copy-binary
     DEPENDEES strip-binary
-    COMMAND ${CMAKE_COMMAND} -E copy <BINARY_DIR>/mpv.exe                           ${CMAKE_CURRENT_BINARY_DIR}/mpv-package/mpv.exe
-    COMMAND ${CMAKE_COMMAND} -E copy <BINARY_DIR>/mpv.com                           ${CMAKE_CURRENT_BINARY_DIR}/mpv-package/mpv.com
-    COMMAND ${CMAKE_COMMAND} -E copy <SOURCE_DIR>/etc/mpv-register.bat              ${CMAKE_CURRENT_BINARY_DIR}/mpv-package/mpv-register.bat
-    COMMAND ${CMAKE_COMMAND} -E copy <SOURCE_DIR>/etc/mpv-unregister.bat            ${CMAKE_CURRENT_BINARY_DIR}/mpv-package/mpv-unregister.bat
-    COMMAND ${CMAKE_COMMAND} -E copy <BINARY_DIR>/mpv.pdf                           ${CMAKE_CURRENT_BINARY_DIR}/mpv-package/doc/manual.pdf
-    COMMAND ${CMAKE_COMMAND} -E copy ${MINGW_INSTALL_PREFIX}/etc/fonts/fonts.conf   ${CMAKE_CURRENT_BINARY_DIR}/mpv-package/mpv/fonts.conf
-    ${mpv_copy_debug}
     COMMAND ${CMAKE_COMMAND} -E copy <BINARY_DIR>/libmpv-2.dll          ${CMAKE_CURRENT_BINARY_DIR}/mpv-dev/libmpv-2.dll
     COMMAND ${CMAKE_COMMAND} -E copy <BINARY_DIR>/libmpv.dll.a          ${CMAKE_CURRENT_BINARY_DIR}/mpv-dev/libmpv.dll.a
     COMMAND ${CMAKE_COMMAND} -E copy <SOURCE_DIR>/include/mpv/client.h       ${CMAKE_CURRENT_BINARY_DIR}/mpv-dev/include/mpv/client.h
     COMMAND ${CMAKE_COMMAND} -E copy <SOURCE_DIR>/include/mpv/stream_cb.h    ${CMAKE_CURRENT_BINARY_DIR}/mpv-dev/include/mpv/stream_cb.h
     COMMAND ${CMAKE_COMMAND} -E copy <SOURCE_DIR>/include/mpv/render.h       ${CMAKE_CURRENT_BINARY_DIR}/mpv-dev/include/mpv/render.h
     COMMAND ${CMAKE_COMMAND} -E copy <SOURCE_DIR>/include/mpv/render_gl.h    ${CMAKE_CURRENT_BINARY_DIR}/mpv-dev/include/mpv/render_gl.h
-    COMMENT "Copying mpv binaries and manual"
+    COMMENT "Copying libmpv binaries and headers"
 )
 
 set(RENAME ${CMAKE_CURRENT_BINARY_DIR}/mpv-prefix/src/rename.sh)
@@ -99,14 +92,9 @@ mv $2 $2-git-\${GIT}")
 ExternalProject_Add_Step(mpv copy-package-dir
     DEPENDEES copy-binary
     COMMAND chmod 755 ${RENAME}
-    COMMAND mv ${CMAKE_CURRENT_BINARY_DIR}/mpv-package ${CMAKE_BINARY_DIR}/mpv-${TARGET_CPU}${x86_64_LEVEL}-${BUILDDATE}
-    COMMAND ${RENAME} <SOURCE_DIR> ${CMAKE_BINARY_DIR}/mpv-${TARGET_CPU}${x86_64_LEVEL}-${BUILDDATE}
 
-    COMMAND mv ${CMAKE_CURRENT_BINARY_DIR}/mpv-debug ${CMAKE_BINARY_DIR}/mpv-debug-${TARGET_CPU}${x86_64_LEVEL}-${BUILDDATE}
-    COMMAND ${RENAME} <SOURCE_DIR> ${CMAKE_BINARY_DIR}/mpv-debug-${TARGET_CPU}${x86_64_LEVEL}-${BUILDDATE}
-
-    COMMAND mv ${CMAKE_CURRENT_BINARY_DIR}/mpv-dev ${CMAKE_BINARY_DIR}/mpv-dev-${TARGET_CPU}${x86_64_LEVEL}-${BUILDDATE}
-    COMMAND ${RENAME} <SOURCE_DIR> ${CMAKE_BINARY_DIR}/mpv-dev-${TARGET_CPU}${x86_64_LEVEL}-${BUILDDATE}
+    COMMAND mv ${CMAKE_CURRENT_BINARY_DIR}/mpv-dev ${CMAKE_BINARY_DIR}/mpv-dev${MPV_PACKAGE_SUFFIX}-${TARGET_CPU}${x86_64_LEVEL}-${BUILDDATE}
+    COMMAND ${RENAME} <SOURCE_DIR> ${CMAKE_BINARY_DIR}/mpv-dev${MPV_PACKAGE_SUFFIX}-${TARGET_CPU}${x86_64_LEVEL}-${BUILDDATE}
     COMMENT "Moving mpv package folder"
     LOG 1
 )
-- 
2.54.0.windows.1

