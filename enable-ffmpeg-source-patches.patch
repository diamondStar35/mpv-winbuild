From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: diamondStar35 <ramymaherali55@gmail.com>
Date: Fri, 30 Oct 2026 20:00:00 +0200
Subject: [PATCH] ffmpeg: apply required source patches before configuration

Apply the staged FFmpeg patches through ExternalProject's patch step, after
source updates and before configuration. Conflicts must stop the build.
---
 packages/ffmpeg.cmake | 1 +
 1 file changed, 1 insertion(+)

diff --git a/packages/ffmpeg.cmake b/packages/ffmpeg.cmake
--- a/packages/ffmpeg.cmake
+++ b/packages/ffmpeg.cmake
@@ -47,6 +47,7 @@ ExternalProject_Add(ffmpeg
     SOURCE_DIR ${SOURCE_LOCATION}
     GIT_CLONE_FLAGS "--sparse --filter=tree:0"
     GIT_CLONE_POST_COMMAND "sparse-checkout set --no-cone /* !tests/ref/fate"
+    PATCH_COMMAND ${EXEC} git am --3way ${CMAKE_CURRENT_SOURCE_DIR}/ffmpeg-*.patch
     UPDATE_COMMAND ""
     CONFIGURE_COMMAND ${EXEC} CONF=1 <SOURCE_DIR>/configure
         --cross-prefix=${TARGET_ARCH}-
-- 
2.54.0.windows.1
