From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: diamondStar35 <ramymaherali55@gmail.com>
Date: Sun, 15 Nov 2026 21:00:00 +0200
Subject: [PATCH] avfilter: rearm drained audio graphs for gapless recordings

Add avfilter_graph_new_stream for recording boundaries, distinct from a
seek reset. Preserve streaming EQ, limiter and spatial signal history,
while restarting the normalizer analysis. Retain only its output-gain
endpoint to interpolate smoothly into the fresh recording.

Cover streaming continuity, fresh analysis, timestamp restart and seek
history clearing in the native regression executable.
---
diff --git a/libavfilter/af_alimiter.c b/libavfilter/af_alimiter.c
index 8af2651..15bffca 100644
--- a/libavfilter/af_alimiter.c
+++ b/libavfilter/af_alimiter.c
@@ -421,6 +421,17 @@ static int reset_history(AVFilterContext *ctx)
     return 0;
 }
 
+static int new_stream(AVFilterContext *ctx)
+{
+    AudioLimiterContext *s = ctx->priv;
+    /* Latency compensation has already padded the preceding recording. */
+    if (s->latency)
+        return reset_history(ctx);
+    av_fifo_reset2(s->fifo);
+    s->next_in_pts = s->next_out_pts = AV_NOPTS_VALUE;
+    return 0;
+}
+
 static const AVFilterPad alimiter_inputs[] = {
     {
         .name         = "main",
@@ -439,6 +450,7 @@ static const AVFilterPad alimiter_outputs[] = {
 };
 
 const FFFilter ff_af_alimiter = {
+    .new_stream    = new_stream,
     .reset         = reset_history,
     .p.name         = "alimiter",
     .p.description  = NULL_IF_CONFIG_SMALL("Audio lookahead limiter."),
diff --git a/libavfilter/af_biquads.c b/libavfilter/af_biquads.c
index ec2a51d..0e43805 100644
--- a/libavfilter/af_biquads.c
+++ b/libavfilter/af_biquads.c
@@ -1463,6 +1463,17 @@ static int reset_history(AVFilterContext *ctx)
     return 0;
 }
 
+static int new_stream(AVFilterContext *ctx)
+{
+    BiquadsContext *s = ctx->priv;
+    if (s->block_samples > 0)
+        return reset_history(ctx);
+    memset(s->clip, 0, ctx->inputs[0]->ch_layout.nb_channels * sizeof(*s->clip));
+    s->pts = AV_NOPTS_VALUE;
+    s->nb_samples = 0;
+    return 0;
+}
+
 #define DEFINE_BIQUAD_FILTER_2(name_, description_, priv_class_)        \
 static av_cold int name_##_init(AVFilterContext *ctx)                   \
 {                                                                       \
@@ -1482,6 +1493,7 @@ const FFFilter ff_af_##name_ = {                         \
     .init          = name_##_init,                       \
     .activate      = activate,                           \
     .reset         = reset_history, \
+    .new_stream    = new_stream, \
     .uninit        = uninit,                             \
     FILTER_INPUTS(ff_audio_default_filterpad),           \
     FILTER_OUTPUTS(outputs),                             \
diff --git a/libavfilter/af_dynaudnorm.c b/libavfilter/af_dynaudnorm.c
index 6e0da97..1e5fc8c 100644
--- a/libavfilter/af_dynaudnorm.c
+++ b/libavfilter/af_dynaudnorm.c
@@ -94,6 +94,7 @@ typedef struct DynamicAudioNormalizerContext {
     double compress_factor;
     double threshold;
     double *prev_amplification_factor;
+    int preserve_gain;
     double *dc_correction_value;
     double *compress_threshold;
     double *weights;
@@ -530,7 +531,8 @@ static void update_gain_history(DynamicAudioNormalizerContext *s, int channel,
         const int pre_fill_size = s->filter_size / 2;
         const double initial_value = s->alt_boundary_mode ? gain.max_gain : fmin(1.0, gain.max_gain);
 
-        s->prev_amplification_factor[channel] = initial_value;
+        if (!s->preserve_gain)
+            s->prev_amplification_factor[channel] = initial_value;
 
         while (cqueue_size(s->gain_history_original[channel]) < pre_fill_size) {
             cqueue_enqueue(s->gain_history_original[channel], initial_value);
@@ -795,6 +797,7 @@ static int analyze_frame(AVFilterContext *ctx, AVFilterLink *outlink, AVFrame **
         ff_filter_execute(ctx, update_gain_histories, analyze_frame, NULL,
                           FFMIN(s->channels, ff_filter_get_nb_threads(ctx)));
     }
+    s->preserve_gain = 0;
 
     return 0;
 }
@@ -1026,7 +1029,7 @@ static int process_command(AVFilterContext *ctx, const char *cmd, const char *ar
     return 0;
 }
 
-static int reset_history(AVFilterContext *ctx)
+static int reset_analysis(AVFilterContext *ctx, int preserve_gain)
 {
     DynamicAudioNormalizerContext *s = ctx->priv;
     ff_bufqueue_discard_all(&s->queue);
@@ -1034,10 +1037,12 @@ static int reset_history(AVFilterContext *ctx)
     s->pts = AV_NOPTS_VALUE;
     s->var_values[VAR_T] = NAN;
     s->var_values[VAR_SN] = 0;
+    s->preserve_gain = preserve_gain;
     for (int c = 0; c < s->channels; c++) {
         cqueue *queues[] = { s->gain_history_original[c], s->gain_history_minimum[c],
                             s->gain_history_smoothed[c], s->threshold_history[c] };
-        s->prev_amplification_factor[c] = 1.;
+        if (!preserve_gain)
+            s->prev_amplification_factor[c] = 1.;
         s->dc_correction_value[c] = s->compress_threshold[c] = 0.;
         for (unsigned i = 0; i < FF_ARRAY_ELEMS(queues); i++)
             queues[i]->nb_elements = 0;
@@ -1056,6 +1061,18 @@ static int reset_history(AVFilterContext *ctx)
     return 0;
 }
 
+static int reset_history(AVFilterContext *ctx)
+{
+    return reset_analysis(ctx, 0);
+}
+
+static int new_stream(AVFilterContext *ctx)
+{
+    /* Gain interpolation is signal continuity, not the analysis window.
+     * Keep its endpoint while starting a fresh analysis for the next recording. */
+    return reset_analysis(ctx, 1);
+}
+
 static const AVFilterPad avfilter_af_dynaudnorm_inputs[] = {
     {
         .name           = "default",
@@ -1065,6 +1082,7 @@ static const AVFilterPad avfilter_af_dynaudnorm_inputs[] = {
 };
 
 const FFFilter ff_af_dynaudnorm = {
+    .new_stream    = new_stream,
     .reset         = reset_history,
     .p.name        = "dynaudnorm",
     .p.description = NULL_IF_CONFIG_SMALL("Dynamic Audio Normalizer."),
