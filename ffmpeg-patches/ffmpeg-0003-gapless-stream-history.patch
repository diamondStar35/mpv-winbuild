diff --git a/libavfilter/avfilter.h b/libavfilter/avfilter.h
index a790fbc..ee99a50 100644
--- a/libavfilter/avfilter.h
+++ b/libavfilter/avfilter.h
@@ -1230,6 +1230,13 @@ int avfilter_graph_request_oldest(AVFilterGraph *graph);
  */
 int avfilter_graph_reset(AVFilterGraph *graph);
 
+/** Start a compatible recording after the previous recording has drained.
+ * Re-arm EOF and timestamps while retaining signal-processing history.
+ * Analysis filters start a fresh analysis. Runtime options remain configured.
+ * No graph execution may be in progress when this function is called.
+ */
+int avfilter_graph_new_stream(AVFilterGraph *graph);
+
 /**
  * @}
  */
diff --git a/libavfilter/avfiltergraph.c b/libavfilter/avfiltergraph.c
index a7c3096..b8cd014 100644
--- a/libavfilter/avfiltergraph.c
+++ b/libavfilter/avfiltergraph.c
@@ -1691,13 +1691,14 @@ int ff_filter_graph_run_once(AVFilterGraph *graph)
     return ff_filter_activate(&ctxi->p);
 }
 
-int avfilter_graph_reset(AVFilterGraph *graph)
+static int reset_audio_graph(AVFilterGraph *graph, int new_stream)
 {
-    FFFilterGraph *g = fffiltergraph(graph);
+    FFFilterGraph *g;
     int ret;
 
     if (!graph || !graph->nb_filters)
         return AVERROR(EINVAL);
+    g = fffiltergraph(graph);
     /* Preflight every node before changing any state, including auto converters. */
     for (unsigned i = 0; i < graph->nb_filters; i++) {
         AVFilterContext *ctx = graph->filters[i];
@@ -1737,7 +1738,8 @@ int avfilter_graph_reset(AVFilterGraph *graph)
             li->l.frame_count_in = li->l.frame_count_out = 0;
             li->l.sample_count_in = li->l.sample_count_out = 0;
         }
-        ret = fffilter(ctx->filter)->reset(ctx);
+        const FFFilter *filter = fffilter(ctx->filter);
+        ret = new_stream && filter->new_stream ? filter->new_stream(ctx) : filter->reset(ctx);
         if (ret < 0)
             return ret;
         if (ctx->enable_str) {
@@ -1752,3 +1754,13 @@ int avfilter_graph_reset(AVFilterGraph *graph)
         g->sink_links[i]->age_index = i;
     return 0;
 }
+
+int avfilter_graph_reset(AVFilterGraph *graph)
+{
+    return reset_audio_graph(graph, 0);
+}
+
+int avfilter_graph_new_stream(AVFilterGraph *graph)
+{
+    return reset_audio_graph(graph, 1);
+}
diff --git a/libavfilter/filters.h b/libavfilter/filters.h
index dc205b2..8cc7cc3 100644
--- a/libavfilter/filters.h
+++ b/libavfilter/filters.h
@@ -480,6 +480,10 @@ typedef struct FFFilter {
      * A failure requires the caller to rebuild the graph before further use.
      */
     int (*reset)(AVFilterContext *ctx);
+    /** Start another compatible recording without dropping signal history.
+     * NULL uses reset(), including a fresh analysis for per-track processors.
+     */
+    int (*new_stream)(AVFilterContext *ctx);
 } FFFilter;
 
 static inline const FFFilter *fffilter(const AVFilter *f)
diff --git a/libavfilter/tests/history_reset.c b/libavfilter/tests/history_reset.c
index 15d237f..2ace7f1 100644
--- a/libavfilter/tests/history_reset.c
+++ b/libavfilter/tests/history_reset.c
@@ -133,6 +133,126 @@ static int test_reset(const char *filter)
     return 0;
 }
 
+static int feed_tone(AVFilterContext *src, int64_t start, int64_t pts, double amplitude)
+{
+    AVFrame *f = av_frame_alloc();
+    int ret;
+    if (!f) return AVERROR(ENOMEM);
+    f->format = AV_SAMPLE_FMT_FLTP; f->sample_rate = 48000;
+    f->ch_layout = (AVChannelLayout)AV_CHANNEL_LAYOUT_STEREO;
+    f->nb_samples = 1024; f->pts = pts;
+    ret = av_frame_get_buffer(f, 0);
+    if (ret >= 0) {
+        for (int ch = 0; ch < 2; ch++)
+            for (int i = 0; i < f->nb_samples; i++)
+                ((float *)f->extended_data[ch])[i] = amplitude * sin(2 * M_PI * 523.25 * (start + i) / 48000);
+        ret = av_buffersrc_add_frame(src, f);
+    }
+    av_frame_free(&f);
+    return ret;
+}
+
+static int read_signal(AVFilterContext *sink, float *samples, int *count, int capacity)
+{
+    AVFrame *f = av_frame_alloc();
+    int ret;
+    if (!f) return AVERROR(ENOMEM);
+    while ((ret = av_buffersink_get_frame(sink, f)) >= 0) {
+        if (f->format != AV_SAMPLE_FMT_FLTP || f->nb_samples > capacity - *count) {
+            av_frame_free(&f);
+            return AVERROR_INVALIDDATA;
+        }
+        memcpy(samples + *count, f->extended_data[0], f->nb_samples * sizeof(*samples));
+        *count += f->nb_samples;
+        av_frame_unref(f);
+    }
+    av_frame_free(&f);
+    return ret == AVERROR(EAGAIN) || ret == AVERROR_EOF ? 0 : ret;
+}
+
+static int test_stream_continuity(const char *filter)
+{
+    AVFilterContext *src, *sink, *ref_src, *ref_sink;
+    AVFilterGraph *g = create_graph(filter, &src, &sink);
+    AVFilterGraph *reference = create_graph(filter, &ref_src, &ref_sink);
+    enum { CAPACITY = 32 * 1024 };
+    float *actual = av_malloc_array(CAPACITY, sizeof(*actual));
+    float *expected = av_malloc_array(CAPACITY, sizeof(*expected));
+    int actual_count = 0, expected_count = 0;
+    CHECK(g && reference && actual && expected);
+    for (int i = 0; i < 32; i++) {
+        CHECK(feed_tone(src, i * 1024, (i % 16) * 1024, 0.1) >= 0);
+        CHECK(feed_tone(ref_src, i * 1024, i * 1024, 0.1) >= 0);
+        CHECK(read_signal(sink, actual, &actual_count, CAPACITY) == 0);
+        CHECK(read_signal(ref_sink, expected, &expected_count, CAPACITY) == 0);
+        if (i == 15) {
+            CHECK(av_buffersrc_add_frame(src, NULL) >= 0);
+            CHECK(read_signal(sink, actual, &actual_count, CAPACITY) == 0);
+            CHECK(avfilter_graph_new_stream(g) == 0);
+        }
+    }
+    CHECK(av_buffersrc_add_frame(src, NULL) >= 0);
+    CHECK(av_buffersrc_add_frame(ref_src, NULL) >= 0);
+    CHECK(read_signal(sink, actual, &actual_count, CAPACITY) == 0);
+    CHECK(read_signal(ref_sink, expected, &expected_count, CAPACITY) == 0);
+    CHECK(actual_count == expected_count && actual_count == CAPACITY);
+    for (int i = 0; i < actual_count; i++)
+        CHECK(fabs(actual[i] - expected[i]) < 1e-6);
+    av_free(actual); av_free(expected);
+    avfilter_graph_free(&g); avfilter_graph_free(&reference);
+    return 0;
+}
+
+static int test_fresh_analysis(void)
+{
+    const char *filter = "dynaudnorm=f=150:g=15:b=1,aformat=sample_fmts=fltp";
+    AVFilterContext *src, *sink, *ref_src, *ref_sink;
+    AVFilterGraph *g = create_graph(filter, &src, &sink);
+    AVFilterGraph *reference = create_graph(filter, &ref_src, &ref_sink);
+    enum { CAPACITY = 160 * 1024 };
+    float *actual = av_malloc_array(CAPACITY, sizeof(*actual));
+    float *expected = av_malloc_array(CAPACITY, sizeof(*expected));
+    int actual_count = 0, expected_count = 0;
+    double difference = 0, previous_gain, next_gain, tone;
+    CHECK(g && reference && actual && expected);
+    for (int i = 0; i < 160; i++) {
+        CHECK(feed_tone(src, i * 1024, i * 1024, 0.1) >= 0);
+        CHECK(read_signal(sink, actual, &actual_count, CAPACITY) == 0);
+    }
+    CHECK(av_buffersrc_add_frame(src, NULL) >= 0);
+    CHECK(read_signal(sink, actual, &actual_count, CAPACITY) == 0);
+    CHECK(actual_count == CAPACITY);
+    previous_gain = actual[CAPACITY - 1] /
+        (0.1 * sin(2 * M_PI * 523.25 * (CAPACITY - 1) / 48000));
+    CHECK(avfilter_graph_new_stream(g) == 0);
+    actual_count = 0;
+    for (int i = 0; i < 160; i++) {
+        CHECK(feed_tone(src, i * 1024, i * 1024, 0.25) >= 0);
+        CHECK(feed_tone(ref_src, i * 1024, i * 1024, 0.25) >= 0);
+        CHECK(read_signal(sink, actual, &actual_count, CAPACITY) == 0);
+        CHECK(read_signal(ref_sink, expected, &expected_count, CAPACITY) == 0);
+    }
+    CHECK(av_buffersrc_add_frame(src, NULL) >= 0);
+    CHECK(av_buffersrc_add_frame(ref_src, NULL) >= 0);
+    CHECK(read_signal(sink, actual, &actual_count, CAPACITY) == 0);
+    CHECK(read_signal(ref_sink, expected, &expected_count, CAPACITY) == 0);
+    CHECK(actual_count == CAPACITY && expected_count == CAPACITY);
+    /* Only the first gain ramp continues the previous output. Every later
+     * frame must use the same fresh analysis as an independent recording. */
+    for (int i = 0; i < 7200; i++)
+        difference += fabs(actual[i] - expected[i]);
+    CHECK(difference > 1);
+    for (int i = 7200; i < CAPACITY; i++)
+        CHECK(fabs(actual[i] - expected[i]) < 1e-6);
+    CHECK(fabs(actual[0]) < 1e-7);
+    tone = 0.25 * sin(2 * M_PI * 523.25 / 48000);
+    next_gain = expected[1] / tone;
+    CHECK(fabs(actual[1] / tone - (previous_gain + (next_gain - previous_gain) * 2 / 7200)) < 1e-5);
+    av_free(actual); av_free(expected);
+    avfilter_graph_free(&g); avfilter_graph_free(&reference);
+    return 0;
+}
+
 int main(int argc, char **argv)
 {
     static const char *filters[] = {
@@ -146,6 +266,9 @@ int main(int argc, char **argv)
         "aformat=channel_layouts=mono,aresample=44100,aresample=48000,aformat=channel_layouts=stereo:sample_fmts=fltp",
         "equalizer=f=1000:g=3,dynaudnorm=f=150:g=15,alimiter=limit=0.95,stereotools=balance_out=0.1,aformat=sample_fmts=fltp",
     };
+    CHECK(test_stream_continuity("equalizer=f=600:g=10,alimiter=limit=0.95,aformat=sample_fmts=fltp") == 0);
+    CHECK(test_stream_continuity("stereotools=delay=20,aformat=sample_fmts=fltp") == 0);
+    CHECK(test_fresh_analysis() == 0);
     for (unsigned i = 0; i < sizeof(filters) / sizeof(filters[0]); i++) {
         printf("history reset: %s\n", filters[i]);
         CHECK(test_reset(filters[i]) == 0);
@@ -178,6 +301,8 @@ int main(int argc, char **argv)
         AVFilterContext *src, *sink, *sofa;
         AVFilterGraph *g;
         double rotation;
+        snprintf(filter, sizeof(filter), "sofalizer=sofa='%s':type=freq,aformat=sample_fmts=fltp", argv[1]);
+        CHECK(test_stream_continuity(filter) == 0);
         /* Use a relative path, or escape the path as a lavfi option. */
         snprintf(filter, sizeof(filter), "sofalizer@hrtf=sofa=%s:type=freq,aformat=sample_fmts=fltp", argv[1]);
         CHECK(test_reset(filter) == 0);
