+
+static float convolute_sample(SOFAlizerContext *s, const float *buffer,
+                              int write, int delay, const float *ir, float *tmp)
+{
+    const int length = s->sofa.ir_samples;
+    const int read = (write - delay - length + 1) & (s->buffer_length - 1);
+    const int first = FFMIN(length, s->buffer_length - read);
+
+    memcpy(tmp, buffer + read, first * sizeof(*tmp));
+    memcpy(tmp + first, buffer, (length - first) * sizeof(*tmp));
+    return s->fdsp->scalarproduct_float(ir, tmp, FFALIGN(length, 32));
+}
