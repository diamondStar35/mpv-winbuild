diff --git a/libavfilter/tests/history_reset.c b/libavfilter/tests/history_reset.c
new file mode 100644
index 0000000..15d237f
--- /dev/null
+++ b/libavfilter/tests/history_reset.c
@@ -0,0 +1,195 @@
+/* Regression coverage for the history-only graph reset API. LGPL-2.1-or-later. */
+#include <errno.h>
+#include <math.h>
+#include <stdio.h>
+#include <string.h>
+#include "libavutil/channel_layout.h"
+#include "libavutil/mem.h"
+#include "libavutil/opt.h"
+#include "libavfilter/avfilter.h"
+#include "libavfilter/buffersrc.h"
+#include "libavfilter/buffersink.h"
+
+#define CHECK(x) do { if (!(x)) { fprintf(stderr, "line %d: %s\n", __LINE__, #x); return 1; } } while (0)
+
+static AVFilterGraph *create_graph(const char *filter, AVFilterContext **src, AVFilterContext **sink)
+{
+    AVFilterGraph *g = avfilter_graph_alloc();
+    AVFilterInOut *inputs = avfilter_inout_alloc(), *outputs = avfilter_inout_alloc();
+    int ret;
+    if (!g || !inputs || !outputs)
+        goto fail;
+    if (avfilter_graph_create_filter(src, avfilter_get_by_name("abuffer"), "source",
+            "sample_rate=48000:sample_fmt=fltp:channel_layout=stereo:time_base=1/48000", NULL, g) < 0 ||
+        avfilter_graph_create_filter(sink, avfilter_get_by_name("abuffersink"), "sink", NULL, NULL, g) < 0)
+        goto fail;
+    outputs->name = av_strdup("in"); outputs->filter_ctx = *src;
+    inputs->name = av_strdup("out"); inputs->filter_ctx = *sink;
+    ret = avfilter_graph_parse_ptr(g, filter, &inputs, &outputs, NULL);
+    avfilter_inout_free(&inputs); avfilter_inout_free(&outputs);
+    if (ret < 0 || avfilter_graph_config(g, NULL) < 0)
+        goto fail;
+    return g;
+fail:
+    avfilter_inout_free(&inputs); avfilter_inout_free(&outputs);
+    avfilter_graph_free(&g);
+    return NULL;
+}
+
+static int feed(AVFilterContext *src, int64_t pts, int impulse)
+{
+    AVFrame *f = av_frame_alloc();
+    int ret;
+    if (!f) return AVERROR(ENOMEM);
+    f->format = AV_SAMPLE_FMT_FLTP; f->sample_rate = 48000;
+    f->ch_layout = (AVChannelLayout)AV_CHANNEL_LAYOUT_STEREO;
+    f->nb_samples = 1024; f->pts = pts;
+    ret = av_frame_get_buffer(f, 0);
+    if (ret >= 0) {
+        av_samples_set_silence(f->extended_data, 0, f->nb_samples, 2, f->format);
+        if (impulse)
+            ((float *)f->extended_data[0])[0] = ((float *)f->extended_data[1])[0] = 0.8f;
+        ret = av_buffersrc_add_frame(src, f);
+    }
+    av_frame_free(&f);
+    return ret;
+}
+
+static double output_energy;
+
+static int drain(AVFilterContext *sink, int silent, int *frames)
+{
+    AVFrame *f = av_frame_alloc();
+    int ret;
+    if (!f) return AVERROR(ENOMEM);
+    while ((ret = av_buffersink_get_frame(sink, f)) >= 0) {
+        (*frames)++;
+        if (f->format != AV_SAMPLE_FMT_FLTP) { ret = AVERROR_INVALIDDATA; break; }
+        for (int c = 0; c < f->ch_layout.nb_channels; c++) {
+            for (int n = 0; n < f->nb_samples; n++) {
+                double value = ((float *)f->extended_data[c])[n];
+                output_energy += value * value;
+                if (silent && fabs(value) > 1e-7) {
+                    av_frame_free(&f);
+                    return AVERROR_INVALIDDATA;
+                }
+            }
+        }
+        av_frame_unref(f);
+    }
+    av_frame_free(&f);
+    return ret == AVERROR_EOF || ret == AVERROR(EAGAIN) ? 0 : ret;
+}
+
+static int test_reset(const char *filter)
+{
+    AVFilterContext *src = NULL, *sink = NULL;
+    AVFilterGraph *g = create_graph(filter, &src, &sink);
+    AVFilterContext **identities;
+    int frames = 0;
+    CHECK(g);
+    identities = av_memdup(g->filters, g->nb_filters * sizeof(*identities));
+    CHECK(identities);
+    for (int cycle = 0; cycle < 3; cycle++) {
+        CHECK(feed(src, 0, 1) >= 0);
+        CHECK(drain(sink, 0, &frames) == 0);
+        CHECK(feed(src, 1024, 1) >= 0);
+        /* Include queued samples and an EOF which has not yet been consumed. */
+        CHECK(av_buffersrc_add_frame(src, NULL) >= 0);
+        CHECK(avfilter_graph_reset(g) == 0);
+        for (unsigned i = 0; i < g->nb_filters; i++) CHECK(g->filters[i] == identities[i]);
+        for (int i = 0; i < 160; i++) {
+            CHECK(feed(src, 480000 + i * 1024, 0) >= 0);
+            CHECK(drain(sink, 1, &frames) == 0);
+        }
+        CHECK(av_buffersrc_add_frame(src, NULL) >= 0);
+        CHECK(drain(sink, 1, &frames) == 0);
+        CHECK(avfilter_graph_reset(g) == 0);
+        {
+            AVFilterContext *fresh_src, *fresh_sink;
+            AVFilterGraph *fresh = create_graph(filter, &fresh_src, &fresh_sink);
+            double actual, expected;
+            int actual_frames = 0, expected_frames = 0;
+            CHECK(fresh);
+            output_energy = 0;
+            CHECK(feed(src, 0, 1) >= 0);
+            CHECK(av_buffersrc_add_frame(src, NULL) >= 0);
+            CHECK(drain(sink, 0, &actual_frames) == 0);
+            actual = output_energy;
+            output_energy = 0;
+            CHECK(feed(fresh_src, 0, 1) >= 0);
+            CHECK(av_buffersrc_add_frame(fresh_src, NULL) >= 0);
+            CHECK(drain(fresh_sink, 0, &expected_frames) == 0);
+            expected = output_energy;
+            CHECK(actual_frames == expected_frames);
+            CHECK(fabs(actual - expected) <= 1e-7 * (1 + expected));
+            avfilter_graph_free(&fresh);
+            CHECK(avfilter_graph_reset(g) == 0);
+        }
+    }
+    CHECK(frames > 0 || strstr(filter, "silenceremove"));
+    av_free(identities);
+    avfilter_graph_free(&g);
+    return 0;
+}
+
+int main(int argc, char **argv)
+{
+    static const char *filters[] = {
+        "aformat=sample_fmts=fltp",
+        "equalizer=f=1000:t=q:w=1:g=6,aformat=sample_fmts=fltp",
+        "equalizer=f=1000:t=q:w=1:g=6:blocksize=512,aformat=sample_fmts=fltp",
+        "stereotools=delay=20,aformat=sample_fmts=fltp",
+        "alimiter=limit=0.95:latency=1,aformat=sample_fmts=fltp",
+        "dynaudnorm=f=150:g=15,aformat=sample_fmts=fltp",
+        "silenceremove=start_periods=1:start_threshold=0.01:stop_periods=-1:stop_threshold=0.01,aformat=sample_fmts=fltp",
+        "aformat=channel_layouts=mono,aresample=44100,aresample=48000,aformat=channel_layouts=stereo:sample_fmts=fltp",
+        "equalizer=f=1000:g=3,dynaudnorm=f=150:g=15,alimiter=limit=0.95,stereotools=balance_out=0.1,aformat=sample_fmts=fltp",
+    };
+    for (unsigned i = 0; i < sizeof(filters) / sizeof(filters[0]); i++) {
+        printf("history reset: %s\n", filters[i]);
+        CHECK(test_reset(filters[i]) == 0);
+    }
+    {
+        AVFilterContext *src, *sink, *tone;
+        AVFilterGraph *g = create_graph("equalizer@tone=f=1000:g=3,aformat=sample_fmts=fltp", &src, &sink);
+        double gain;
+        CHECK(g);
+        tone = avfilter_graph_get_filter(g, "equalizer@tone"); CHECK(tone);
+        CHECK(avfilter_process_command(tone, "g", "9", NULL, 0, 0) == 0);
+        CHECK(avfilter_process_command(tone, "enable", "0", NULL, 0, 0) == 0);
+        CHECK(avfilter_graph_reset(g) == 0);
+        CHECK(av_opt_get_double(tone->priv, "g", 0, &gain) == 0 && gain == 9);
+        CHECK(tone->enable_str && !strcmp(tone->enable_str, "0"));
+        avfilter_graph_free(&g);
+    }
+    /* The unsupported-node preflight must not clear the source's EOF. */
+    {
+        AVFilterContext *src, *sink;
+        AVFilterGraph *g = create_graph("aecho,aformat=sample_fmts=fltp", &src, &sink);
+        CHECK(g);
+        CHECK(av_buffersrc_add_frame(src, NULL) >= 0);
+        CHECK(avfilter_graph_reset(g) == AVERROR(ENOSYS));
+        CHECK(feed(src, 0, 0) < 0);
+        avfilter_graph_free(&g);
+    }
+    if (argc > 1) {
+        char filter[4096];
+        AVFilterContext *src, *sink, *sofa;
+        AVFilterGraph *g;
+        double rotation;
+        /* Use a relative path, or escape the path as a lavfi option. */
+        snprintf(filter, sizeof(filter), "sofalizer@hrtf=sofa=%s:type=freq,aformat=sample_fmts=fltp", argv[1]);
+        CHECK(test_reset(filter) == 0);
+        g = create_graph(filter, &src, &sink); CHECK(g);
+        sofa = avfilter_graph_get_filter(g, "sofalizer@hrtf"); CHECK(sofa);
+        CHECK(avfilter_process_command(sofa, "rotation", "-355", NULL, 0, 0) == 0);
+        CHECK(avfilter_process_command(sofa, "elevation", "90", NULL, 0, 0) == 0);
+        CHECK(avfilter_graph_reset(g) == 0);
+        CHECK(av_opt_get_double(sofa->priv, "rotation", 0, &rotation) == 0 && rotation == -355);
+        CHECK(av_opt_get_double(sofa->priv, "elevation", 0, &rotation) == 0 && rotation == 90);
+        avfilter_graph_free(&g);
+    }
+    puts("history reset checks passed");
+    return 0;
+}
