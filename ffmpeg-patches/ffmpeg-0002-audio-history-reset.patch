@@ -403,6 +403,24 @@ static av_cold void uninit(AVFilterContext *ctx)
     av_fifo_freep2(&s->fifo);
 }
 
+static int reset_history(AVFilterContext *ctx)
+{
+    AudioLimiterContext *s = ctx->priv;
+    const int channels = ctx->inputs[0]->ch_layout.nb_channels;
+    const int size = ctx->inputs[0]->sample_rate * (int64_t)channels / 10 + channels;
+    memset(s->buffer, 0, size * sizeof(*s->buffer));
+    memset(s->nextdelta, 0, size * sizeof(*s->nextdelta));
+    memset(s->nextpos, -1, size * sizeof(*s->nextpos));
+    av_fifo_reset2(s->fifo);
+    s->att = 1.;
+    s->asc = s->delta = 0.;
+    s->asc_pos = -1;
+    s->asc_c = s->asc_changed = s->pos = s->nextiter = s->nextlen = 0;
+    s->in_trim = s->out_pad = s->latency ? s->buffer_size / channels - 1 : 0;
+    s->next_in_pts = s->next_out_pts = AV_NOPTS_VALUE;
+    return 0;
+}
