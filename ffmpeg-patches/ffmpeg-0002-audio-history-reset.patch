diff --git a/libavfilter/avfilter.h b/libavfilter/avfilter.h
index a6b875c..7146589 100644
--- a/libavfilter/avfilter.h
+++ b/libavfilter/avfilter.h
@@ -1198,6 +1198,15 @@ char *avfilter_graph_dump(AVFilterGraph *graph, const char *options);
  */
 int avfilter_graph_request_oldest(AVFilterGraph *graph);
 
+/**
+ * Discard queued audio, EOF and stream history while retaining configured filters.
+ * The caller must serialize this with all graph operations. Unsupported graphs
+ * return AVERROR(ENOSYS) without mutation. Other errors leave the graph unusable
+ * until rebuilt. Scheduled commands belong to the old timeline and are removed;
+ * current options and negotiated link properties are preserved.
+ */
+int avfilter_graph_reset(AVFilterGraph *graph);
+
 /**
  * @}
  */
diff --git a/libavfilter/avfiltergraph.c b/libavfilter/avfiltergraph.c
index 7d089ad..af6b601 100644
--- a/libavfilter/avfiltergraph.c
+++ b/libavfilter/avfiltergraph.c
@@ -1655,3 +1655,65 @@ int ff_filter_graph_run_once(AVFilterGraph *graph)
         return AVERROR(EAGAIN);
     return ff_filter_activate(&ctxi->p);
 }
+
+int avfilter_graph_reset(AVFilterGraph *graph)
+{
+    FFFilterGraph *g = fffiltergraph(graph);
+    int ret;
+
+    if (!graph || !graph->nb_filters)
+        return AVERROR(EINVAL);
+    /* Preflight every node before changing any state, including auto converters. */
+    for (unsigned i = 0; i < graph->nb_filters; i++) {
+        AVFilterContext *ctx = graph->filters[i];
+        if (!fffilter(ctx->filter)->reset)
+            return AVERROR(ENOSYS);
+        for (unsigned j = 0; j < ctx->nb_outputs; j++)
+            if (!ctx->outputs[j] || ff_link_internal(ctx->outputs[j])->init_state != AVLINK_INIT ||
+                ctx->outputs[j]->type != AVMEDIA_TYPE_AUDIO)
+                return AVERROR(ENOSYS);
+    }
+    for (unsigned i = 0; i < graph->nb_filters; i++) {
+        AVFilterContext *ctx = graph->filters[i];
+        FFFilterContext *fc = fffilterctx(ctx);
+        fc->ready = 0;
+        while (fc->command_queue) {
+            AVFilterCommand *cmd = fc->command_queue;
+            fc->command_queue = cmd->next;
+            av_free(cmd->command);
+            av_free(cmd->arg);
+            av_free(cmd);
+        }
+        for (unsigned j = 0; j < ctx->nb_outputs; j++) {
+            AVFilterLink *link = ctx->outputs[j];
+            FilterLinkInternal *li = ff_link_internal(link);
+            FFFrameQueue *q = &li->fifo;
+            while (q->queued) {
+                AVFrame *frame = ff_framequeue_take(q);
+                av_frame_free(&frame);
+            }
+            q->total_frames_head = q->total_frames_tail = 0;
+            q->total_samples_head = q->total_samples_tail = 0;
+            q->samples_skipped = 0;
+            li->status_in = li->status_out = 0;
+            li->status_in_pts = AV_NOPTS_VALUE;
+            li->frame_blocked_in = li->frame_wanted_out = 0;
+            li->l.current_pts = li->l.current_pts_us = AV_NOPTS_VALUE;
+            li->l.frame_count_in = li->l.frame_count_out = 0;
+            li->l.sample_count_in = li->l.sample_count_out = 0;
+        }
+        ret = fffilter(ctx->filter)->reset(ctx);
+        if (ret < 0)
+            return ret;
+        if (ctx->enable_str) {
+            ret = avfilter_process_command(ctx, "enable", ctx->enable_str, NULL, 0, 0);
+            if (ret < 0)
+                return ret;
+        }
+        ctx->is_disabled = 0;
+    }
+    /* All timestamps are equal again, so the existing sink heap is valid. */
+    for (int i = 0; i < g->sink_links_count; i++)
+        g->sink_links[i]->age_index = i;
+    return 0;
+}
