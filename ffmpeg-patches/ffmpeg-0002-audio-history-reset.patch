From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: diamondStar35 <ramymaherali55@gmail.com>
Date: Sat, 31 Oct 2026 12:00:00 +0200
Subject: [PATCH] avfilter: reset audio history without discarding configured filters

Separate stream-history reset from filter configuration and resource lifetime.
Preserve runtime parameters; rebuild safely for unsupported or incompatible graphs.
---
diff --git a/libavfilter/Makefile b/libavfilter/Makefile
index e00652e..71c6fa9 100644
--- a/libavfilter/Makefile
+++ b/libavfilter/Makefile
@@ -687,7 +687,7 @@ SKIPHEADERS-$(CONFIG_VULKAN)                 += vulkan_filter.h
 SKIPHEADERS-$(CONFIG_SCALE_CUDA_FILTER)      += vf_scale_cuda.h
 
 TOOLS     = graph2dot
-TESTPROGS = drawutils filtfmts formats integral
+TESTPROGS = drawutils filtfmts formats integral history_reset
 
 TESTPROGS-$(CONFIG_DRAWVG_FILTER) += drawvg
 
@@ -702,3 +702,11 @@ OPENCL = $(subst $(SRC_PATH)/,,$(wildcard $(SRC_PATH)/libavfilter/opencl/*.cl))
 libavfilter/opencl/%.c: TAG = OPENCL
 libavfilter/opencl/%.c: $(SRC_PATH)/libavfilter/opencl/%.cl
 	$(M)$(SRC_PATH)/tools/source2c $< $@
+
+# Ship regression executables separately from the player/runtime package.
+all: libavfilter/tests/history_reset$(EXESUF)
+install: install-history-reset-test
+.PHONY: install-history-reset-test
+install-history-reset-test: libavfilter/tests/history_reset$(EXESUF)
+	$(Q)mkdir -p "$(DESTDIR)$(prefix)/native-tests"
+	$(Q)cp $< "$(DESTDIR)$(prefix)/native-tests/"
